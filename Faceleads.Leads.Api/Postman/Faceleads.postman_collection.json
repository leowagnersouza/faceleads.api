{
  "info": {
    "name": "Faceleads Leads API",
    "_postman_id": "faceleads-leads-api",
    "description": "Cole��o Postman com endpoints principais da API Faceleads Leads",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:7062",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "consultor_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"admin\",\n  \"Password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res && res.value) {",
              "  if (res.value.access_token) pm.environment.set('access_token', res.value.access_token);",
              "  if (res.value.refresh_token) pm.environment.set('refresh_token', res.value.refresh_token);",
              "}",
              "pm.test('Login successful', () => pm.expect(res && res.success).to.eql(true));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Consultores - Listar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/consultores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res && res.value && res.value.id) {",
              "  pm.environment.set('consultor_id', res.value.id);",
              "}",
              "pm.test('Consultor created', () => pm.expect(res && res.success).to.eql(true));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Consultores - Obter por Id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/consultores/:consultor_id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api", "v1", "consultores", ":consultor_id"
          ],
          "variable": [
            {
              "key": "consultor_id",
              "value": "{{consultor_id}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Consultores - Criar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"NomeCompleto\": \"Jo�o da Silva\",\n  \"Email\": \"joao.silva@example.com\",\n  \"Telefone\": \"+5511999999999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/consultores"
      },
      "response": []
    },
    {
      "name": "Consultores - Atualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"NomeCompleto\": \"Jo�o da Silva Atualizado\",\n  \"Email\": \"joao.atualizado@example.com\",\n  \"Telefone\": \"+5511988888888\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/consultores/:consultor_id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api", "v1", "consultores", ":consultor_id"
          ],
          "variable": [
            {
              "key": "consultor_id",
              "value": "{{consultor_id}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Consultores - Ativar",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/consultores/:consultor_id/ativar"
      },
      "response": []
    },
    {
      "name": "Consultores - Desativar",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/consultores/:consultor_id/desativar"
      },
      "response": []
    },
    {
      "name": "Consultores - Excluir (soft)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/consultores/:consultor_id"
      },
      "response": []
    },
    {
      "name": "Tokens - Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RefreshToken\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res && res.value) {",
              "  if (res.value.access_token) pm.environment.set('access_token', res.value.access_token);",
              "  if (res.value.refresh_token) pm.environment.set('refresh_token', res.value.refresh_token);",
              "}",
              "pm.test('Refresh successful', () => pm.expect(res && res.success).to.eql(true));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Logout - Revoke Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RefreshToken\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/logout"
      },
      "response": []
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "response": []
    }
  ]
}
